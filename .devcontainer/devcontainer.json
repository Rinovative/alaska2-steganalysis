{
    "name": "alaska2-steganalysis",
    "build": {
        "dockerfile": "Dockerfile",
        "context": ".."
    },
    "runArgs": [
        "--gpus",
        "all",
        "--ipc",
        "host"
    ],
    "containerEnv": {
        "POETRY_VIRTUALENVS_CREATE": "false",
        "POETRY_VIRTUALENVS_IN_PROJECT": "false"
    },
    "workspaceFolder": "/workspaces/alaska2-steganalysis",
    "postCreateCommand": "poetry install --with dev,notebook,optimization,generation --extras cuda --no-interaction --no-ansi --no-cache && rm -rf /root/.cache/pip /root/.cache/pypoetry",
    "customizations": {
        "vscode": {
            "settings": {
                "python.defaultInterpreterPath": "/opt/conda/bin/python",
                "python-envs.workspaceSearchPaths": [],
                "python-envs.terminal.autoActivationType": "off"
            },
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "ms-toolsai.jupyter",
                "openai.chatgpt"
            ]
        }
    }
}
